#!/usr/bin/env python3
"""The three MeshCore firmwares for sim-mesh, as firmware zips.

    variants/sim_mesh_sx1262/sim/make-zips [--out DIR] [--no-build] [--arch ARCH]... [ROLE ...]

ROLE is companion, repeater or room (all three without). Run from the
repository's root with PlatformIO on PATH, the libuv and libi2c headers installed, and sim-mesh's clone beside this
repository. Every role is built for the machine's own architecture, in
.pio/build; sim-mesh's radio library is built first when its clone has none
yet. --arch builds another architecture too (aarch64, x86_64): with its
cross g++ (g++-<arch>-linux-gnu, and its libc from the multiarch packages)
in .pio/build.linux-<arch>, SIM_MESH_ARCH telling sim-mesh's cross.py and
link.py which. Each build is `pio run -e sim_mesh_sx1262_<role>`; its
program must need nothing beyond the C library, the C++ runtime and
sim-mesh's radio (checked with readelf). Each zip is
`<base>-<release>_<arch>_<UTC stamp>.zip` in DIR (default .pio/sim-zips),
the release the role's example's FIRMWARE_VERSION
(meshcore-repeater-sx1262-1.17.1), holding node.yaml, the program, stripped
of its symbols and debug sections (by strip, or <arch>-linux-gnu-strip for
another architecture), and driver.py; the companion's also holds host.py,
which needs nothing beyond Python's standard library.
"""

import argparse
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
import time
import zipfile

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.normpath(os.path.join(HERE, "..", "..", ".."))
RADIO = os.path.normpath(os.path.join(ROOT, "..", "sim-mesh", "radio"))
ALLOWED = re.compile(r"^(libc|libm|libstdc\+\+|libgcc_s|ld-linux[-\w]*|libsimradio-[\w-]+)\.so")
ARCHES = ("aarch64", "x86_64")

# Each role: its base before the release, its title, and the example whose
# MyMesh.h says the release (FIRMWARE_VERSION).
ROLES = {
    "companion": ("meshcore-companion-sx1262", "MeshCore companion %s", "companion_radio"),
    "repeater": ("meshcore-repeater-sx1262", "MeshCore repeater %s", "simple_repeater"),
    "room": ("meshcore-room-sx1262", "MeshCore room server %s", "simple_room_server"),
}


def run(argv, **kwargs):
    print("+ " + " ".join(argv), flush=True)
    subprocess.run(argv, check=True, **kwargs)


def check_needed(program):
    out = subprocess.run(["readelf", "-d", program], check=True, capture_output=True,
                         text=True).stdout
    needed = re.findall(r"\(NEEDED\)\s+Shared library: \[([^\]]+)\]", out)
    stray = [lib for lib in needed if not ALLOWED.match(lib)]
    if stray:
        sys.exit("%s needs %s, which sim-mesh does not provide" % (program, ", ".join(stray)))


def release(role):
    """The role's MeshCore release, as its example's FIRMWARE_VERSION says
    it, without the leading v: 1.17.1."""
    path = os.path.join(ROOT, "examples", ROLES[role][2], "MyMesh.h")
    with open(path, encoding="utf-8") as f:
        found = re.search(r'#define\s+FIRMWARE_VERSION\s+"v?([0-9][^"]*)"', f.read())
    if not found:
        sys.exit("%s says no FIRMWARE_VERSION" % path)
    return found.group(1)


def node_yaml(role, base, arch, stamp):
    lines = [
        "base: %s" % base,
        "arch: %s" % arch,
        "version: '%s'" % stamp,
        "category: meshcore",
        "radio: sx1262",
        "title: %s" % (ROLES[role][1] % release(role)),
        "hardware: ESP32-S3",
        "exec: %s" % ("host.py" if role == "companion" else "program"),
        "driver: driver.py",
    ]
    return "\n".join(lines) + "\n"


def radio_built():
    """sim-mesh's radio library for this machine, which a native build links:
    built in sim-mesh's clone when it has none (`sim` builds it as it starts)."""
    build = os.path.join(RADIO, "build")
    if not os.path.isdir(RADIO):
        sys.exit("no sim-mesh clone beside this repository (%s)" % os.path.dirname(RADIO))
    if not os.path.exists(os.path.join(build, "libsimradio-sx1262.so")):
        run(["cmake", "-S", RADIO, "-B", build])
        run(["cmake", "--build", build, "--target", "simradio-sx1262"])


def make(role, out_dir, stamp, arch, build):
    base = "%s-%s" % (ROLES[role][0], release(role))
    env_name = "sim_mesh_sx1262_%s" % role
    build_dir = os.path.join(ROOT, ".pio", "build" if arch == platform.machine()
                             else "build.linux-%s" % arch)
    if build:
        if arch == platform.machine():
            radio_built()
        run(["pio", "run", "-e", env_name], cwd=ROOT,
            env=dict(os.environ, SIM_MESH_ARCH=arch, PLATFORMIO_BUILD_DIR=build_dir))
    program = os.path.join(build_dir, env_name, "program")
    check_needed(program)

    name = "%s_%s_%s" % (base, arch, stamp)
    with tempfile.TemporaryDirectory() as tmp:
        strip = "strip" if arch == platform.machine() else "%s-linux-gnu-strip" % arch
        run([strip, "--strip-all", "-o", os.path.join(tmp, "program"), program])
        program = os.path.join(tmp, "program")
        files = {"node.yaml": None, "program": program,
                 "driver.py": os.path.join(HERE, "driver.py")}
        if role == "companion":
            files["host.py"] = os.path.join(HERE, "host.py")
        zip_path = os.path.join(out_dir, name + ".zip")
        with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as zf:
            zf.writestr("node.yaml", node_yaml(role, base, arch, stamp))
            for member, source in files.items():
                if source is not None:
                    zf.write(source, member)
    print(zip_path, flush=True)
    return zip_path


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("roles", nargs="*", metavar="ROLE", help="companion, repeater, room")
    parser.add_argument("--out", default=os.path.join(ROOT, ".pio", "sim-zips"))
    parser.add_argument("--no-build", action="store_true", help="zip what is built already")
    parser.add_argument("--arch", choices=ARCHES, action="append",
                        help="build for this architecture (the machine's own when not given); "
                             "more than once for several")
    args = parser.parse_args()
    roles = args.roles or ["repeater", "room", "companion"]
    for role in roles:
        if role not in ROLES:
            parser.error("no role %r (there are %s)" % (role, ", ".join(sorted(ROLES))))
    os.makedirs(args.out, exist_ok=True)
    stamp = time.strftime("%Y%m%d%H%M%S", time.gmtime())
    for arch in args.arch or [platform.machine()]:
        for role in roles:
            make(role, args.out, stamp, arch, not args.no_build)


if __name__ == "__main__":
    main()
